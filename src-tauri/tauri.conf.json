{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Herdr Pet",
  "version": "0.4.0-beta.1",
  "identifier": "dev.herdr.pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet-overlay",
        "title": "Herdr Pet",
        "url": "index.html",
        "width": 320,
        "height": 416,
        "minWidth": 96,
        "minHeight": 125,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": true
      },
      {
        "label": "agent-bubbles",
        "title": "Herdr Pet Agents",
        "url": "index.html",
        "width": 76,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "agent-list",
        "title": "Herdr Pet Agent List",
        "url": "index.html",
        "width": 360,
        "height": 222,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "category": "Utility",
    "shortDescription": "A desktop companion for Herdr agents",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "licenses/HERDR_PET_LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../third-party/avatar-lab/LICENSE": "licenses/AVATAR_LAB_LICENSE",
      "../third-party/herdr/LICENSE": "licenses/HERDR_LICENSE"
    }
  }
}
